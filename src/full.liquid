<div class="layout">
  {%- if has_data -%}
  <div class="bc">
    <div class="bc-body">
      <section class="bc-panel">
        <span class="bc-eyebrow bc-px"><span class="bc-eb-long">{% if found %}Next prayer{% else %}Tomorrow{% endif %} · </span>{{ countdown_text }}</span>
        <span class="bc-name">{{ next_label }}</span>
        {%- if found -%}{%- assign ptr = next_index | times: 2 | plus: 1 | times: 100.0 | divided_by: 12 -%}<span class="bc-pointer" style="top:{{ ptr }}%;"></span>{%- endif %}
        <span class="bc-time"><span class="num">{{ next_num }}</span>{% if next_sfx != "" %}<span class="sfx">{{ next_sfx }}</span>{% endif %}</span>
      </section>
      <section class="bc-sched">
        <div class="bc-list">
          {%- for name in prayer_names -%}
          <div class="bc-row {{ states[forloop.index0] }}"><span class="bc-n">{{ labels[forloop.index0] }}</span><span class="bc-t">{{ prayer_times[forloop.index0] }}</span></div>
          {%- endfor -%}
        </div>
      </section>
    </div>
  </div>
  {%- else -%}
  <span class="title">Prayer times unavailable</span>
  <span class="description">Check the Location setting.</span>
  {%- endif -%}
</div>
<div class="title_bar">
  <span class="title">Salah Times</span>
  <span class="instance"><span class="bc-long">{% if location_name != "" %}{{ location_name }} · {% endif %}{{ weekday }} {{ date }} · Updated {{ last_refreshed }}</span><span class="bc-mid">{% if location_name != "" %}{{ location_name }} · {% endif %}{{ date }} · {{ last_refreshed }}</span><span class="bc-short">{% if location_name != "" %}{{ location_name }} · {% endif %}{{ last_refreshed }}</span><span class="bc-tiny">{% if location_name != "" %}{{ location_name }}{% else %}{{ last_refreshed }}{% endif %}</span></span>
</div>
