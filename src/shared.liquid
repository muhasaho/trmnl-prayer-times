{%- comment -%}
  Shared logic for every layout. TRMNL prepends this to each layout's markup.
  Input: `data` is the AlAdhan /v1/timings response polled by the plugin.
  Output: prayer_names, prayer_times (display strings), next_index, next_prayer,
  next_time, found (false after Isha), minutes_until, countdown_text, states
  (past/next/up per prayer), labels (Dhuhr shows as Jumuʿah on Fridays), date,
  weekday, location_name, last_refreshed, has_data. Styles for every layout are
  at the end of this file.
{%- endcomment -%}
{%- assign has_data = false -%}
{%- if data.timings.Fajr -%}{%- assign has_data = true -%}{%- endif -%}

{%- assign time_format = trmnl.plugin_settings.custom_fields_values.time_format | default: "12" -%}

{%- comment -%} Local time in the TRMNL account's time zone. {%- endcomment -%}
{%- assign now_s = "now" | date: "%s" | plus: trmnl.user.utc_offset -%}
{%- assign now_h = now_s | date: "%H" | plus: 0 -%}
{%- assign now_m = now_s | date: "%M" | plus: 0 -%}
{%- assign now_min = now_h | times: 60 | plus: now_m -%}
{%- if time_format == "24" -%}
  {%- assign last_refreshed = now_s | date: "%H:%M" -%}
{%- else -%}
  {%- assign last_refreshed = now_s | date: "%-l:%M %p" -%}
{%- endif -%}
{%- assign date = data.date.readable -%}

{%- comment -%} next_index: first prayer later than now, wrapping to Fajr after Isha. {%- endcomment -%}
{%- assign prayer_names = "Fajr,Sunrise,Dhuhr,Asr,Maghrib,Isha" | split: "," -%}
{%- assign next_index = 0 -%}
{%- assign found = false -%}
{%- assign display = "" -%}
{%- for name in prayer_names -%}
  {%- assign t = data.timings[name] | split: " " | first -%}
  {%- assign hh = t | split: ":" | first -%}
  {%- assign h = hh | plus: 0 -%}
  {%- assign m = t | split: ":" | last -%}
  {%- assign mins = h | times: 60 | plus: m -%}
  {%- if forloop.first -%}{%- assign first_mins = mins -%}{%- endif -%}
  {%- if found == false and mins > now_min -%}
    {%- assign next_index = forloop.index0 -%}
    {%- assign next_mins = mins -%}
    {%- assign found = true -%}
  {%- endif -%}
  {%- if time_format == "24" -%}
    {%- capture shown -%}{{ hh }}:{{ m }}{%- endcapture -%}
  {%- else -%}
    {%- assign h12 = h | modulo: 12 -%}
    {%- if h12 == 0 -%}{%- assign h12 = 12 -%}{%- endif -%}
    {%- if h >= 12 -%}{%- assign ampm = "PM" -%}{%- else -%}{%- assign ampm = "AM" -%}{%- endif -%}
    {%- capture shown -%}{{ h12 }}:{{ m }} {{ ampm }}{%- endcapture -%}
  {%- endif -%}
  {%- assign display = display | append: shown | append: "|" -%}
{%- endfor -%}
{%- assign prayer_times = display | split: "|" -%}
{%- assign next_prayer = prayer_names[next_index] -%}
{%- assign prayer_letters = "F,S,D,A,M,I" | split: "," -%}

{%- comment -%} Time until the next prayer; after Isha it counts to tomorrow's Fajr (approximated by today's). {%- endcomment -%}
{%- if found -%}
  {%- assign minutes_until = next_mins | minus: now_min -%}
{%- else -%}
  {%- assign minutes_until = first_mins | plus: 1440 | minus: now_min -%}
{%- endif -%}
{%- assign until_h = minutes_until | divided_by: 60 | floor -%}
{%- assign until_m = minutes_until | modulo: 60 -%}
{%- if until_h > 0 -%}
  {%- capture countdown -%}{{ until_h }}h {{ until_m }}m{%- endcapture -%}
{%- else -%}
  {%- capture countdown -%}{{ until_m }}m{%- endcapture -%}
{%- endif -%}
{%- assign next_time = prayer_times[next_index] -%}
{%- assign weekday = data.date.gregorian.weekday.en -%}
{%- capture hijri_date -%}{{ data.date.hijri.day | plus: 0 }} {{ data.date.hijri.month.en }} {{ data.date.hijri.year }}{%- endcapture -%}

{%- comment -%} Mockup extras: per-prayer state, split times, minutes, labels. {%- endcomment -%}
{%- assign states = "" -%}
{%- assign nums = "" -%}
{%- assign suffixes = "" -%}
{%- assign mins_list = "" -%}
{%- assign labels = "" -%}
{%- for name in prayer_names -%}
  {%- assign t = data.timings[name] | split: " " | first -%}
  {%- assign h = t | split: ":" | first | plus: 0 -%}
  {%- assign mm = t | split: ":" | last | plus: 0 -%}
  {%- assign mins = h | times: 60 | plus: mm -%}
  {%- assign mins_list = mins_list | append: mins | append: "," -%}
  {%- if found and forloop.index0 == next_index -%}{%- assign st = "next" -%}
  {%- elsif found == false or forloop.index0 < next_index -%}{%- assign st = "past" -%}
  {%- else -%}{%- assign st = "up" -%}{%- endif -%}
  {%- assign states = states | append: st | append: "," -%}
  {%- assign shown = prayer_times[forloop.index0] -%}
  {%- assign num = shown | split: " " | first -%}
  {%- assign nums = nums | append: num | append: "," -%}
  {%- assign parts = shown | split: " " -%}
  {%- if parts.size > 1 -%}{%- assign sfx = parts.last -%}{%- else -%}{%- assign sfx = "" -%}{%- endif -%}
  {%- assign suffixes = suffixes | append: sfx | append: "," -%}
  {%- assign label = name -%}
  {%- if name == "Dhuhr" and weekday == "Friday" -%}{%- assign label = "Jumuʿah" -%}{%- endif -%}
  {%- assign labels = labels | append: label | append: "," -%}
{%- endfor -%}
{%- assign states = states | split: "," -%}
{%- assign nums = nums | split: "," -%}
{%- assign suffixes = suffixes | split: "," -%}
{%- assign mins_list = mins_list | split: "," -%}
{%- assign labels = labels | split: "," -%}
{%- assign next_label = labels[next_index] -%}
{%- assign next_num = nums[next_index] -%}
{%- assign next_sfx = suffixes[next_index] -%}
{%- if minutes_until < 60 -%}
  {%- capture countdown_text -%}in {{ minutes_until }} min{%- endcapture -%}
{%- else -%}
  {%- capture countdown_text -%}in {{ until_h }} h {{ until_m }} min{%- endcapture -%}
{%- endif -%}
{%- assign after_index = next_index | plus: 1 -%}
{%- if after_index > 5 -%}{%- assign after_index = 0 -%}{%- endif -%}
{%- assign hijri_months = "Muharram,Safar,Rabīʿ I,Rabīʿ II,Jumādā I,Jumādā II,Rajab,Shaʿbān,Ramaḍān,Shawwāl,Dhū al-Qaʿdah,Dhū al-Ḥijjah" | split: "," -%}
{%- assign hijri_mi = data.date.hijri.month.number | minus: 1 -%}
{%- capture hijri_short -%}{{ data.date.hijri.day | plus: 0 }} {{ hijri_months[hijri_mi] }} {{ data.date.hijri.year }}{%- endcapture -%}
{%- assign location_name = trmnl.plugin_settings.custom_fields_values.location_name | strip -%}
<style>
  /* Sizes are unitless OG pixels, multiplied by --s (1.3 on TRMNL X). Each layout picks an
     arrangement: side (panel beside list), stack (panel above list) or wide (two-column list). */
  .bc { --s:1; --name:60; --time:112; --sfx:30; --row:26; --padv:28; --padh:32; --gap:30; --pw:50%; --ptr:15; --namegap:18;
        --ink:#000; --paper:#fff; font-family:"Inter Variable",Inter,sans-serif; color:var(--ink); width:100%; height:100%; display:flex; flex-direction:column; }
  .screen--lg .bc { --s:1.3; }
  .bc-px { font-family:"NicoClean","Inter Variable",sans-serif; -webkit-font-smoothing:none; font-size:calc(16px * var(--s)); letter-spacing:.04em; font-weight:400; }
  .bc-body { flex:1; min-height:0; display:flex; gap:calc(var(--gap) * var(--s) * 1px); align-items:stretch; }

  /* Panel: the next prayer, inverted */
  .bc-panel { position:relative; flex:0 0 var(--pw); box-sizing:border-box; background:var(--ink); color:var(--paper); border-radius:calc(6px * var(--s));
              padding:calc(var(--padv) * var(--s) * 1px) calc(var(--padh) * var(--s) * 1px); display:flex; flex-direction:column; justify-content:center; min-width:0; }
  .bc-eyebrow { text-transform:uppercase; letter-spacing:.14em; white-space:nowrap; }
  .bc-name { font-size:calc(var(--name) * var(--s) * 1px); font-weight:700; line-height:1; margin-top:calc(var(--namegap) * var(--s) * 1px); white-space:nowrap; }
  .bc-time { display:flex; align-items:baseline; gap:calc(8px * var(--s)); line-height:1; margin-top:calc(4px * var(--s)); font-variant-numeric:tabular-nums; white-space:nowrap; }
  .bc-time .num { font-size:calc(var(--time) * var(--s) * 1px); font-weight:650; letter-spacing:-.035em; margin-left:-.055em; }
  .bc-time .sfx { font-size:calc(var(--sfx) * var(--s) * 1px); font-weight:650; }
  .bc-pointer { position:absolute; right:calc(var(--ptr) * var(--s) * -1px); width:0; height:0; transform:translateY(-50%);
                border-left:calc(var(--ptr) * var(--s) * 1px) solid var(--ink); border-top:calc(var(--ptr) * .87 * var(--s) * 1px) solid transparent; border-bottom:calc(var(--ptr) * .87 * var(--s) * 1px) solid transparent; }

  /* Schedule */
  .bc-sched { flex:1; min-width:0; display:flex; flex-direction:column; }
  .bc-list { flex:1; display:flex; flex-direction:column; border-top:2px solid var(--ink); border-bottom:2px solid var(--ink); }
  .bc-row { flex:1; display:flex; justify-content:space-between; align-items:center; gap:8px; padding:0 2px; border-bottom:1px solid var(--ink);
            font-size:calc(var(--row) * var(--s) * 1px); line-height:1; white-space:nowrap; }
  .bc-row:last-child { border-bottom:0; }
  .bc-t { font-variant-numeric:tabular-nums; }
  .bc-row.past { font-weight:400; }
  .bc-row.up { font-weight:550; }
  .bc-row.next { font-weight:800; }

  /* Narrow tiles drop the label prefix and use a shorter title bar */
  .bc-mid, .bc-short, .bc-tiny { display:none; }

  /* Stack: panel above the list */
  .view--half_vertical .bc-body, .screen--portrait .view--full .bc-body, .screen--portrait .view--quadrant .bc-body { flex-direction:column; }
  .view--half_vertical .bc-panel, .screen--portrait .view--full .bc-panel, .screen--portrait .view--quadrant .bc-panel { flex:none; }
  .view--half_vertical .bc-pointer, .screen--portrait .view--full .bc-pointer, .screen--portrait .view--quadrant .bc-pointer { display:none; }

  /* Wide: two-column list beside the panel (half horizontal, landscape) */
  .screen:not(.screen--portrait) .view--half_horizontal .bc-pointer { display:none; }
  .screen:not(.screen--portrait) .view--half_horizontal .bc-list { display:grid; grid-template-columns:1fr 1fr; grid-template-rows:repeat(3,1fr); grid-auto-flow:column; column-gap:calc(20px * var(--s)); border:0;
      background:linear-gradient(var(--ink),var(--ink)) top/100% 2px no-repeat, linear-gradient(var(--ink),var(--ink)) bottom/100% 2px no-repeat; }
  .screen:not(.screen--portrait) .view--half_horizontal .bc-row:nth-child(3) { border-bottom:0; }

  /* Sizes per layout and orientation */
  .screen--portrait .view--full .bc { --name:48; --time:96; --sfx:28; --row:26; --padv:24; --padh:28; --gap:14; }
  .view--half_horizontal .bc { --name:34; --time:60; --sfx:20; --row:20; --padv:14; --padh:22; --gap:22; --pw:45%; --namegap:8; }
  .screen--portrait .view--half_horizontal .bc { --name:30; --time:56; --sfx:18; --row:18; --padv:14; --padh:18; --gap:18; --pw:46%; --ptr:10; --namegap:6; }
  .view--half_vertical .bc { --name:34; --time:64; --sfx:22; --row:21; --padv:14; --padh:20; --gap:8; --namegap:8; }
  .screen--portrait .view--half_vertical .bc { --name:28; --time:52; --sfx:18; --row:18; --padv:12; --padh:14; --gap:8; --namegap:6; }
  .view--quadrant .bc { --name:26; --time:48; --sfx:16; --row:15; --padv:10; --padh:14; --gap:16; --pw:46%; --ptr:9; --namegap:6; }
  .screen--portrait .view--quadrant .bc { --name:22; --time:42; --sfx:15; --row:14; --padv:10; --padh:12; --gap:8; --namegap:4; }

  /* Label and title bar variants */
  .view--quadrant .bc-eb-long, .screen--portrait .view--half_horizontal .bc-eb-long, .screen--portrait .view--half_vertical .bc-eb-long { display:none; }
  .view--quadrant .bc-eyebrow, .screen--portrait .view--half_vertical .bc-eyebrow { letter-spacing:.08em; }
  .screen--portrait .view--full .bc-long, .screen--portrait .view--half_horizontal .bc-long { display:none; }
  .screen--portrait .view--full .bc-mid, .screen--portrait .view--half_horizontal .bc-mid { display:inline; }
  .view--half_vertical .bc-long, .view--quadrant .bc-long { display:none; }
  .view--half_vertical .bc-short, .view--quadrant .bc-short { display:inline; }
  .screen--portrait .view--half_vertical .bc-short, .screen--portrait .view--quadrant .bc-short { display:none; }
  .screen--portrait .view--half_vertical .bc-tiny, .screen--portrait .view--quadrant .bc-tiny { display:inline; }
</style>
