{%- comment -%}
  Shared logic for every layout. TRMNL prepends this to each layout's markup.
  Input: `data` is the AlAdhan /v1/timings response polled by the plugin.
  Output: prayer_names, prayer_times (display strings), next_index, next_prayer,
  date, last_refreshed, has_data.
{%- endcomment -%}
{%- assign has_data = false -%}
{%- if data.timings.Fajr -%}{%- assign has_data = true -%}{%- endif -%}

{%- assign time_format = trmnl.plugin_settings.custom_fields_values.time_format | default: "12" -%}

{%- comment -%} Local time in the TRMNL account's time zone. {%- endcomment -%}
{%- assign now_s = "now" | date: "%s" | plus: trmnl.user.utc_offset -%}
{%- assign now_h = now_s | date: "%H" | plus: 0 -%}
{%- assign now_m = now_s | date: "%M" | plus: 0 -%}
{%- assign now_min = now_h | times: 60 | plus: now_m -%}
{%- if time_format == "24" -%}
  {%- assign last_refreshed = now_s | date: "%H:%M" -%}
{%- else -%}
  {%- assign last_refreshed = now_s | date: "%-l:%M %p" -%}
{%- endif -%}
{%- assign date = data.date.readable -%}

{%- comment -%} next_index: first prayer later than now, wrapping to Fajr after Isha. {%- endcomment -%}
{%- assign prayer_names = "Fajr,Sunrise,Dhuhr,Asr,Maghrib,Isha" | split: "," -%}
{%- assign next_index = 0 -%}
{%- assign found = false -%}
{%- assign display = "" -%}
{%- for name in prayer_names -%}
  {%- assign t = data.timings[name] | split: " " | first -%}
  {%- assign hh = t | split: ":" | first -%}
  {%- assign h = hh | plus: 0 -%}
  {%- assign m = t | split: ":" | last -%}
  {%- assign mins = h | times: 60 | plus: m -%}
  {%- if found == false and mins > now_min -%}
    {%- assign next_index = forloop.index0 -%}
    {%- assign found = true -%}
  {%- endif -%}
  {%- if time_format == "24" -%}
    {%- capture shown -%}{{ hh }}:{{ m }}{%- endcapture -%}
  {%- else -%}
    {%- assign h12 = h | modulo: 12 -%}
    {%- if h12 == 0 -%}{%- assign h12 = 12 -%}{%- endif -%}
    {%- if h >= 12 -%}{%- assign ampm = "PM" -%}{%- else -%}{%- assign ampm = "AM" -%}{%- endif -%}
    {%- capture shown -%}{{ h12 }}:{{ m }} {{ ampm }}{%- endcapture -%}
  {%- endif -%}
  {%- assign display = display | append: shown | append: "|" -%}
{%- endfor -%}
{%- assign prayer_times = display | split: "|" -%}
{%- assign next_prayer = prayer_names[next_index] -%}
{%- assign prayer_letters = "F,S,D,A,M,I" | split: "," -%}
